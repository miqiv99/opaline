---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, siteText, type Lang } from "../../i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const text = siteText[lang];
---

<BaseLayout lang={lang} page="privacy" title={`${text.nav.privacy} - Opaline`} description={text.privacy.intro}>
  <section class="page-hero">
    <div class="site-shell">
      <p class="eyebrow">Local first</p>
      <h1>{text.privacy.title}</h1>
      <p class="page-intro">{text.privacy.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-grid">
      <article class="policy-row">
        <h2>{text.privacy.structureTitle}</h2>
        <pre><code>Opaline/
  notes/
  assets/
  .opaline/</code></pre>
        <p>{text.privacy.structureCopy}</p>
      </article>
      <article class="policy-row">
        <h2>{text.privacy.networkTitle}</h2>
        <ul class="fine-list">
          {text.privacy.network.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="policy-row">
        <h2>{text.privacy.apiTitle}</h2>
        <p>{text.privacy.apiCopy}</p>
      </article>
      <article class="notice">
        <h2>{text.privacy.alphaTitle}</h2>
        <p>{text.privacy.alphaCopy}</p>
      </article>
    </div>
  </section>
</BaseLayout>
