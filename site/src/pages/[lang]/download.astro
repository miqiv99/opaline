---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, siteText, type Lang } from "../../i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const text = siteText[lang];
---

<BaseLayout lang={lang} page="download" title={`${text.download.title} - Opaline`} description={text.download.intro}>
  <section class="page-hero">
    <div class="site-shell">
      <p class="eyebrow">v0.1.0 public alpha</p>
      <h1>{text.download.title}</h1>
      <p class="page-intro">{text.download.intro}</p>
      <div class="page-actions">
        <a class="button primary" href="https://github.com/miqiv99/opaline/releases/tag/v0.1.0" rel="noreferrer">{text.download.releaseButton}</a>
        <a class="button" href="https://github.com/miqiv99/opaline" rel="noreferrer">{text.download.sourceButton}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-grid">
      <article class="notice">
        <h2>{text.download.knowTitle}</h2>
        <ul class="fine-list">
          {text.download.notes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="license-box">
        <h2>{text.download.licenseTitle}</h2>
        <p>{text.download.licenseCopy}</p>
      </article>
    </div>
  </section>
</BaseLayout>
