---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, siteText, type Lang } from "../../i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const text = siteText[lang];
---

<BaseLayout lang={lang} page="updates" title={`${text.updates} - Opaline`} description={text.updatesPage.intro}>
  <section class="page-hero">
    <div class="site-shell">
      <p class="eyebrow">Updater manifest placeholder</p>
      <h1>{text.updatesPage.title}</h1>
      <p class="page-intro">{text.updatesPage.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-stack">
      <article class="update-box">
        <h2>{text.updatesPage.statusTitle}</h2>
        <p>{text.updatesPage.statusCopy}</p>
      </article>
      <article class="update-box">
        <h2>{text.updatesPage.pathTitle}</h2>
        <p>{text.updatesPage.pathCopy}</p>
      </article>
    </div>
  </section>
</BaseLayout>
