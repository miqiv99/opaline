---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, siteText, type Lang } from "../../i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const text = siteText[lang];
const repo = "https://github.com/miqiv99/opaline/blob/main";
const hrefs = [
  `${repo}/README.md`,
  `${repo}/README.zh.md`,
  `${repo}/docs/release.md`,
  `${repo}/docs/updater-github.md`,
  `${repo}/docs/data-and-privacy.md`,
  `${repo}/docs/roadmap.html`,
  `${repo}/docs/roadmap.zh.html`,
];
---

<BaseLayout lang={lang} page="docs" title={`${text.docs.title} - Opaline`} description={text.docs.intro}>
  <section class="page-hero">
    <div class="site-shell">
      <p class="eyebrow">Documentation</p>
      <h1>{text.docs.title}</h1>
      <p class="page-intro">{text.docs.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-grid">
      {text.docs.items.map(([title, body], index) => (
        <a class="doc-link" href={hrefs[index]} rel="noreferrer">
          <h2>{title}</h2>
          <p>{body}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
