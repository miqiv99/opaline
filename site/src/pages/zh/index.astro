---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteText } from "../../i18n";

const text = siteText.zh;
---

<BaseLayout lang="zh" page="" title={text.title} description={text.description}>
  <section class="hero">
    <div class="site-shell hero-stack">
      <div class="hero-content">
        <p class="eyebrow">{text.hero.eyebrow}</p>
        <h1>{text.hero.title}</h1>
        <p class="hero-copy">{text.hero.copy}</p>
        <div class="hero-actions">
          <a class="button primary" href="/zh/download">{text.hero.download}</a>
          <a class="button" href="https://github.com/miqiv99/opaline" rel="noreferrer">{text.hero.github}</a>
          <a class="button" href="/zh/docs">{text.hero.docs}</a>
        </div>
      </div>
      <figure class="hero-shot hero-shot-wide">
        <button
          class="shot-zoom"
          type="button"
          data-zoom-src="/media/opaline-editor.png"
          data-zoom-alt={text.hero.imageAlt}
          data-zoom-caption={text.hero.note}
          aria-label="打开产品截图"
        >
          <img src="/media/opaline-editor.png" alt={text.hero.imageAlt} width="1440" height="960" loading="eager" />
        </button>
        <figcaption class="hero-note">
          <span>{text.hero.note}</span>
          <span>{text.hero.noteMeta}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="section-header">
        <h2>{text.home.fileTitle}</h2>
        <p>{text.home.fileCopy}</p>
      </div>
      <div class="feature-grid">
        {text.home.features.map(([title, body]) => (
          <article class="feature">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="section-header">
        <h2>{text.home.shotsTitle}</h2>
        <p>{text.home.shotsCopy}</p>
      </div>
      <div class="shot-grid">
        {text.home.shots.map(([src, caption]) => (
          <figure class="shot">
            <button class="shot-zoom" type="button" data-zoom-src={src} data-zoom-alt={caption} data-zoom-caption={caption} aria-label={`打开截图：${caption}`}>
              <img src={src} alt={caption} width="1440" height="960" loading="lazy" />
            </button>
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
